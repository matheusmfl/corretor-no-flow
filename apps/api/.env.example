NODE_ENV=development
PORT=3001

# Prisma — use container names when running via Docker
DATABASE_URL="postgresql://corretor:corretor@postgres:5432/corretor_db?schema=public"

# Redis — usado pelo BullMQ
REDIS_HOST=redis
REDIS_PORT=6379

# App — dashboard local na 3002; API na 3001
APP_URL=http://localhost:3002
# URL absoluta do link público (/c/{token}). Se vazio, usa APP_URL.
PUBLIC_LINK_BASE_URL=
CORS_ORIGIN=http://localhost:3002
API_URL=http://localhost:3001

# --- Dashboard na Vercel (API local ou túnel): copie e ajuste ---
# Origem exata do front (sem barra no final):
# CORS_ORIGIN=https://corretor-no-flow-dashboard.vercel.app
# Link que o cliente abre e fallback de publicUrl:
# PUBLIC_LINK_BASE_URL=https://corretor-no-flow-dashboard.vercel.app
# APP_URL=https://corretor-no-flow-dashboard.vercel.app
# URL pública da API (túnel), para URLs absolutas geradas pela API quando necessário:
# API_URL=https://SEU_SUBDOMINIO.trycloudflare.com

# Groq (dev/test — gratuito sem billing) — console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini — fallback quando Groq retorna 429 / rate_limit_exceeded (Google AI Studio → API key). Deixe vazio se não usar fallback.
GEMINI_API_KEY=
# Opcional — padrão gemini-2.0-flash; para custo mínimo estável use Flash-Lite (Gemini API docs)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Resend — e-mail transacional — resend.com → API Keys
RESEND_API_KEY=your-resend-api-key-here
# Domínio verificado no Resend (dev: onboarding@resend.dev)
RESEND_FROM_EMAIL=noreply@seudominio.com.br

# Variáveis para build na Vercel (Project → Settings → Environment Variables).
# Substitua a URL do túnel pela sua API pública.

# URL HTTPS do túnel da API (browser e, em geral, mesmo valor no servidor)
NEXT_PUBLIC_API_URL=https://SEU_TUNEL.trycloudflare.com
API_INTERNAL_URL=https://SEU_TUNEL.trycloudflare.com

# Domínio deste dashboard (link público /c/... e cópia para o cliente)
NEXT_PUBLIC_PUBLIC_LINK_BASE_URL=https://corretor-no-flow-dashboard.vercel.app

# Opcional: aparece no header X-Dashboard-Environment nas chamadas à API
# NEXT_PUBLIC_DASHBOARD_ENVIRONMENT=production
